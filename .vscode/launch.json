{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vipeye CLI (vipeye-internal)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceRoot}/packages/vipeye-internal/debug.js",
            "args": [
                "--typeshedpath",
                "${workspaceRoot}/packages/vipeye-internal/typeshed-fallback",
                "--version",
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "outFiles": [
                "${workspaceRoot}/packages/vipeye-internal/out/**/*.js"
            ]
        },
        {
            "name": "Vipeye tests",
            "type": "node",
            "request": "launch",
            "args": [
                "--runInBand"
            ],
            "cwd": "${workspaceRoot}/packages/vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye extension",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "npm: build:extension:dev",
            "args": [
                // 合并架构：vscode-vipeye 单一包含 Viper 核心（packages/viper）源码，
                // 调试只加载这一个扩展。不要追加 packages/viper 的 extensionDevelopmentPath，
                // 否则与合并后的核心重复注册 viper.* 命令 / viper.vpjEditor / 配置属性，
                // 导致 "command 'xxx' already exists" / "Provider ... already registered"
                // / "Cannot register 'viper.xxx' ... already registered" 激活失败。
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-vipeye",
                // 禁用已安装的发布版，避免与调试版同时加载冲突。
                "--disable-extension=TermiNexus.vscode-vipeye",
                "--disable-extension=TermiNexus.vipeye",
            ],
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye extension (watch)",
            "type": "extensionHost",
            "request": "launch",
            "preLaunchTask": "Watch extension",
            "args": [
                // 同 "Vipeye extension"：只加载 vscode-vipeye，不要加载 packages/viper。
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-vipeye",
                "--disable-extension=TermiNexus.vscode-vipeye",
                "--disable-extension=be5invis.vscode-custom-css",
                "--disable-extension=msgcenterext.msgcenter",
                "--disable-extension=TermiNexus.vipeye",
            ],
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye attach server",
            "type": "node",
            "request": "attach",
            "port": 6600,
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye jest current file",
            "type": "node",
            "request": "launch",
            "args": [
                "${fileBasenameNoExtension}",
                "--runInBand",
                "--detectOpenHandles",
                "--forceExit",
                "--testTimeout=180000"
            ],
            "cwd": "${workspaceRoot}/packages/vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye jest selected test",
            "type": "node",
            "request": "launch",
            "args": ["${fileBasenameNoExtension}", "--runInBand", "-t", "${selectedText}", "--forceExit", "--testTimeout=180000"],
            "cwd": "${workspaceRoot}/packages/vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye fourslash current file",
            "type": "node",
            "request": "launch",
            "args": [
                "fourSlashRunner.test.ts",
                "-t ${fileBasenameNoExtension}",
                "--runInBand",
            ],
            "cwd": "${workspaceRoot}/packages/vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/vipeye-internal/node_modules/jest/bin/jest"
        }
    ]
}