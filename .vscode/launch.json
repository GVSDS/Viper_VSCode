{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Vipeye CLI",
            "type": "node",
            "request": "launch",
            "program": "${workspaceRoot}/packages/Vipeye/index.js",
            "preLaunchTask": "npm: build:cli:dev",
            "args": [
                "--verifytypes",
                "pandas.core.reshape.concat",
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "outFiles": [
                "${workspaceRoot}/packages/Vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye CLI (Vipeye-internal)",
            "type": "node",
            "request": "launch",
            "program": "${workspaceRoot}/packages/Vipeye-internal/debug.js",
            "args": [
                "--typeshedpath",
                "${workspaceRoot}/packages/Vipeye-internal/typeshed-fallback",
                "--version",
            ],
            "internalConsoleOptions": "openOnSessionStart",
            "outFiles": [
                "${workspaceRoot}/packages/Vipeye-internal/out/**/*.js"
            ]
        },
        {
            "name": "Vipeye tests",
            "type": "node",
            "request": "launch",
            "args": [
                "--runInBand"
            ],
            "cwd": "${workspaceRoot}/packages/Vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/Vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye extension",
            "type": "extensionHost",
            "request": "launch",
            // "runtimeExecutable": "${workspaceRoot}/packages/vscode-Vipeye/dist/extension.js",
            "preLaunchTask": "npm: build:extension:dev",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-Vipeye",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/viper",
                // The published extension is named "ms-Vipeye.Vipeye", but in debug mode it's "ms-Vipeye.vscode-Vipeye"
                // to allow the extension code to participate in the lerna monorepo. Make sure that the published extension
                // isn't enabled, otherwise both are loaded and conflict.
                "--disable-extension=ms-Vipeye.Vipeye"
            ],
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-Vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye extension (watch)",
            "type": "extensionHost",
            "request": "launch",
            // "runtimeExecutable": "${workspaceRoot}/packages/vscode-Vipeye/dist/extension.js",
            "preLaunchTask": "Watch extension",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-Vipeye",
                "--extensionDevelopmentPath=${workspaceFolder}/packages/viper",
                // The published extension is named "ms-Vipeye.Vipeye", but in debug mode it's "ms-Vipeye.vscode-Vipeye"
                // to allow the extension code to participate in the lerna monorepo. Make sure that the published extension
                // isn't enabled, otherwise both are loaded and conflict.
                "--disable-extension=ms-Vipeye.Vipeye",
                "--disable-extension=be5invis.vscode-custom-css",
                "--disable-extension=msgcenterext.msgcenter"
            ],
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-Vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye attach server",
            "type": "node",
            "request": "attach",
            "port": 6600,
            "smartStep": true,
            "sourceMaps": true,
            "outFiles": [
                "${workspaceRoot}/packages/vscode-Vipeye/dist/**/*.js"
            ]
        },
        {
            "name": "Vipeye jest current file",
            "type": "node",
            "request": "launch",
            "args": [
                "${fileBasenameNoExtension}",
                "--runInBand",
                "--detectOpenHandles",
                "--forceExit",
                "--testTimeout=180000"
            ],
            "cwd": "${workspaceRoot}/packages/Vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/Vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye jest selected test",
            "type": "node",
            "request": "launch",
            "args": ["${fileBasenameNoExtension}", "--runInBand", "-t", "${selectedText}", "--forceExit", "--testTimeout=180000"],
            "cwd": "${workspaceRoot}/packages/Vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/Vipeye-internal/node_modules/jest/bin/jest"
        },
        {
            "name": "Vipeye fourslash current file",
            "type": "node",
            "request": "launch",
            "args": [
                "fourSlashRunner.test.ts",
                "-t ${fileBasenameNoExtension}",
                "--runInBand",
            ],
            "cwd": "${workspaceRoot}/packages/Vipeye-internal",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "program": "${workspaceFolder}/packages/Vipeye-internal/node_modules/jest/bin/jest"
        }
    ]
}