@c.Attribute(t.attr.packed)
class lfn_entry:
	LDIR_Ord:       t.CUInt8T
	LDIR_Name1:     t.CArray[t.CUInt16T, 5]
	LDIR_Attr:      t.CUInt8T
	LDIR_Type:      t.CUInt8T
