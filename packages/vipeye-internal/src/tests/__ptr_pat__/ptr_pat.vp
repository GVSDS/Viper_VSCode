import t, llvmlite

def test(rhs_val: llvmlite.Value | t.CPtr) -> t.CInt:
    if rhs_val.Ty is None:
        return 0
    match rhs_val.Ty:
        case llvmlite.LLVMType.Struct(_, _, _):
            tmp: llvmlite.Value | t.CPtr = llvmlite.build_alloca(rhs_val, rhs_val.Ty)
            return 0
    return 0
