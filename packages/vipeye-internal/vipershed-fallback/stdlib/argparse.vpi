# Viper 命令行参数解析库 argparse 存根。
# Python argparse 风格的 C 实现，依赖 memhub 和 hashtable。
# 姑息策略：
#   - 类型/动作常量映射为 int
#   - _mbuddy 为模块级全局 MemBuddy 指针（int）
#   - Argument/ParsedArgs/ArgumentParser 内部指针字段映射为 int

import t
import string
import stdio
import memhub
import hashtable


# ============================================================
# 类型常量
# ============================================================
STRING: int = 0    # 字符串类型
INT: int = 1       # 整数类型
BOOL: int = 2      # 布尔类型

# 动作常量
STORE: int = 0         # 存储值（默认）
STORE_TRUE: int = 1    # 出现时存 True
STORE_FALSE: int = 2   # 出现时存 False
COUNT: int = 3         # 计数出现次数

# 限制
MAX_ARGS: int = 32     # 单个 parser 最大参数数


# 模块级 mbuddy 指针（由用户在 main 中赋值）
_mbuddy: int  # memhub.MemBuddy | t.CPtr


# ============================================================
# Argument - 参数定义结构体
# ============================================================
class Argument:
    """命令行参数定义。"""
    name: str           # "--input" 或 "output"（位置参数）
    short_name: str     # "-i" 或 None
    help_text: str      # 帮助文本
    arg_type: int       # STRING, INT, BOOL
    action: int         # STORE, STORE_TRUE, STORE_FALSE, COUNT
    default_int: int    # INT 类型默认值
    default_str: str    # STRING 类型默认值
    required: bool      # 是否必须
    is_positional: bool # 是否位置参数
    dest: str           # 查找键名（"--input" → "input"）


# ============================================================
# ParsedArgs - 解析结果
# ============================================================
class ParsedArgs:
    """参数解析结果，内部用 HashTable 存储。"""
    _ht: int                # hashtable.HashTable 指针
    __mbuddy__: int         # memhub.MemBuddy 指针

    def __new__(self, mb: int) -> int:
        """堆分配 ParsedArgs 对象。"""
        return 0

    def __init__(self, mb: int) -> None:
        """初始化解析结果。

        Args:
            mb: MemBuddy 指针（int）
        """
        ...

    def get_str(self, name: str) -> str:
        """获取字符串值。

        Args:
            name: 键名（dest）
        Returns:
            字符串值，键不存在返回 None
        """
        return ""

    def get_int(self, name: str) -> int:
        """获取整数值。

        Args:
            name: 键名（dest）
        Returns:
            整数值，键不存在返回 0
        """
        return 0

    def get_bool(self, name: str) -> int:
        """获取布尔值（返回 1 或 0）。

        Args:
            name: 键名（dest）
        Returns:
            1 或 0，键不存在返回 0
        """
        return 0

    def has(self, name: str) -> bool:
        """检查键是否存在。"""
        return False

    def _set_str(self, name: str, val: str) -> None: ...
    def _set_int(self, name: str, val: int) -> None: ...
    def _set_bool(self, name: str, val: bool) -> None: ...


# ============================================================
# ArgumentParser - 命令行参数解析器
# ============================================================
class ArgumentParser:
    """命令行参数解析器。

    用法:
        argparse._mbuddy = mb
        parser = ArgumentParser("myprog", "A test", pool=mb)
        parser.add_argument("--input", "-i", arg_type=argparse.STRING,
                            required=True, help="input file")
        parser.add_argument("--count", "-c", arg_type=argparse.INT,
                            default=0, help="repeat count")
        parser.add_argument("--verbose", "-v", action=argparse.STORE_TRUE,
                            help="verbose mode")
        parser.add_argument("output", arg_type=argparse.STRING,
                            help="output path")
        args = parser.parse_args(argc, argv)
        if args is not None:
            inp: str = args.get_str("input")
            cnt: int = args.get_int("count")
            verb: int = args.get_bool("verbose")
            out: str = args.get_str("output")
            argparse.release(args)
    """
    _prog: str
    _description: str
    _args: int          # Argument 数组基址（指针）
    _arg_count: int
    __mbuddy__: int     # memhub.MemBuddy 指针

    def __new__(self, prog: str = "", description: str = "",
                pool: int = 0) -> int:
        """堆分配 ArgumentParser 对象。"""
        return 0

    def __init__(self, prog: str = "", description: str = "",
                 pool: int = 0) -> None:
        """初始化解析器。

        Args:
            prog: 程序名
            description: 描述文本
            pool: MemBuddy 指针（int），为 0 时使用模块级 _mbuddy
        """
        ...

    def add_argument(self, name: str = "", short: str = "",
                     arg_type: int = 0, default: int = 0,
                     default_str: str = "", required: bool = False,
                     action: int = 0, help: str = "") -> None:
        """注册一个命令行参数。

        Args:
            name: 参数名（"--input" 或 "output"）
            short: 短选项（"-i"），可选
            arg_type: 类型（STRING/INT/BOOL）
            default: INT 默认值
            default_str: STRING 默认值
            required: 是否必须
            action: 动作（STORE/STORE_TRUE/STORE_FALSE/COUNT）
            help: 帮助文本
        """
        ...

    def parse_args(self, argc: int, argv: int) -> int:
        """解析命令行参数。

        Args:
            argc: 参数个数
            argv: 参数数组（char**，指针，int），argv[0] 为程序名
        Returns:
            ParsedArgs 指针（int），失败返回 0（None）
        """
        return 0

    def print_help(self) -> None:
        """打印帮助信息到 stdout。"""
        ...

    def print_usage(self) -> None:
        """打印用法简述到 stdout。"""
        ...


# ============================================================
# release - 释放 ParsedArgs 及其内部资源
# ============================================================
def release(args: int) -> None:
    """释放 ParsedArgs 对象及其内部 HashTable。

    Args:
        args: ParsedArgs 指针（int），为 0（None）无操作
    """
    ...
