# Viper 链表数据结构库 linkedlist 存根。
# 提供 LinkedNode/SListNode/GSListNode/GSList/GTreeNode 等节点类型。
# 姑息策略：
#   - 节点指针字段映射为节点类型本身（含 None 表示空指针）
#   - 计数字段映射为 int
#   - 返回节点指针映射为节点类型或 None

from typing import Generic, TypeVar, Optional

T = TypeVar('T')


# ============================================================
# LinkedNode: 非多态继承基类（@t.NoVTable）
# 子类继承此类即"启用"标准链表/树形结构能力：
#   - 双向兄弟链表（next/prev）→ O(1) 删除
#   - 父子树结构（child/last_child/parent）→ O(1) 追加子节点
#   - 子节点计数（child_count）
# ============================================================
class LinkedNode:
    """双向兄弟链表 + 父子树节点基类。

    字段展平嵌入子类，无 vtable 开销（对应 C++ 非多态继承）。
    用法:
        class MyNode(LinkedNode):
            value: int
        root: MyNode = MyNode()
        child: MyNode = MyNode()
        root.append(child)
        child.detach()
    """
    next: Optional['LinkedNode']       # 下一个兄弟节点
    prev: Optional['LinkedNode']       # 上一个兄弟节点（双向链表，O(1) 删除）
    child: Optional['LinkedNode']      # 第一个子节点
    last_child: Optional['LinkedNode'] # 最后一个子节点（O(1) 追加）
    parent: Optional['LinkedNode']     # 父节点
    child_count: int                   # 子节点数

    def append(self, node: 'LinkedNode') -> None:
        """将 node 追加为 self 的最后一个子节点（O(1)）。

        若 node 已在某链表中，调用方应先 node.detach() 再 append。
        """
        ...

    def prepend(self, node: 'LinkedNode') -> None:
        """将 node 插入为 self 的第一个子节点（O(1)）。"""
        ...

    def insert_before(self, node: 'LinkedNode', new_node: 'LinkedNode') -> None:
        """在 node 之前插入 new_node（node 必须是 self 的子节点，O(1)）。"""
        ...

    def insert_after(self, node: 'LinkedNode', new_node: 'LinkedNode') -> None:
        """在 node 之后插入 new_node（node 必须是 self 的子节点，O(1)）。"""
        ...

    def remove_child(self, node: 'LinkedNode') -> None:
        """从 self 的子链表中摘除 node（O(1)）。node 必须是 self 的直接子节点。"""
        ...

    def detach(self) -> None:
        """将 self 从其所在兄弟链表中摘除（O(1)）。

        调用后 self 的 next/prev/parent 被清空，child 链不受影响。
        """
        ...

    def unlink(self) -> None:
        """断开 self 的所有连接（兄弟 + 父子），不递归处理子节点。"""
        ...

    def has_children(self) -> int:
        """返回 1 若有子节点，否则 0。"""
        return 0

    def child_at(self, index: int) -> Optional['LinkedNode']:
        """返回第 index 个子节点（O(n)，从 0 开始），越界返回 None。"""
        return None

    def count_children(self) -> int:
        """遍历计算子节点数（O(n)），用于校验 child_count。"""
        return 0

    def first_sibling(self) -> Optional['LinkedNode']:
        """返回兄弟链表的头节点（沿 prev 回溯）。"""
        return None

    def last_sibling(self) -> Optional['LinkedNode']:
        """返回兄弟链表的尾节点（沿 next 前进）。"""
        return None


# ============================================================
# SListNode: 单向链表节点（@t.NoVTable）
# 轻量级单向链表，仅 Next 指针，无 prev/parent/child
# ============================================================
class SListNode:
    """单向链表节点。"""
    Next: Optional['SListNode']  # 下一个节点

    def append(self, node: 'SListNode') -> 'SListNode':
        """将 node 追加到链表末尾（O(n)），返回 self（head）。"""
        return self

    def append_after(self, node: 'SListNode') -> 'SListNode':
        """将 node 追加到 self 之后（O(1)），返回新的 tail（即 node）。"""
        return node

    def count(self) -> int:
        """遍历计算链表长度（O(n)）。"""
        return 0

    def at(self, index: int) -> Optional['SListNode']:
        """返回第 index 个节点（O(n)，从 0 开始），越界返回 None。"""
        return None

    def remove(self, node: 'SListNode') -> 'SListNode':
        """从链表中移除 node（O(n)），返回新的 head（self）。"""
        return self


# ============================================================
# GSListNode[T]: 泛型单向链表节点（@t.NoVTable + PEP 695 泛型）
# 递归泛型用法：class GNode(GSListNode[GNode]):
# ============================================================
class GSListNode(Generic[T]):
    """泛型单向链表节点。

    相比 SListNode，Next 字段类型为 T，特化后无需向下转型。
    """
    Next: Optional[T]


# ============================================================
# GSList[T]: 泛型单向链表容器（@t.NoVTable + PEP 695 泛型）
# 持有 Head/Tail/Count，提供 O(1) append 和 O(n) at
# ============================================================
class GSList(Generic[T]):
    """泛型单向链表容器。

    节点类型 T 必须继承 GSListNode[T]（以获得 Next 字段）。
    用法:
        lst: GSList[GNode] = GSList[GNode]()
        lst.append(node)
    """
    Head: Optional[T]
    Tail: Optional[T]
    Count: int

    def __init__(self) -> None:
        """初始化空链表。"""
        ...

    def append(self, node: T) -> None:
        """将 node 追加到链表末尾（O(1)）。"""
        ...

    def count(self) -> int:
        """返回节点数（O(1)）。"""
        return 0

    def at(self, index: int) -> Optional[T]:
        """返回第 index 个节点（O(n)，从 0 开始），越界返回 None。"""
        return None


# ============================================================
# GTreeNode[T]: 泛型树节点（@t.NoVTable + PEP 695 泛型）
# 强类型版本的 LinkedNode，所有指针字段类型为 T
# 递归泛型用法：class AST(GTreeNode[AST]):
# ============================================================
class GTreeNode(Generic[T]):
    """泛型树节点。

    强类型版本的 LinkedNode，提供：
      - 双向兄弟链表（Next/Prev）→ O(1) 删除
      - 父子树结构（Child/LastChild/Parent）→ O(1) 追加子节点
      - 子节点计数（Count）
    """
    Next: Optional[T]       # 下一个兄弟节点
    Prev: Optional[T]       # 上一个兄弟节点（双向链表，O(1) 删除）
    Child: Optional[T]      # 第一个子节点
    LastChild: Optional[T]  # 最后一个子节点（O(1) 追加）
    Parent: Optional[T]     # 父节点
    Count: int              # 子节点数

    def append(self, node: T) -> None:
        """将 node 追加为 self 的最后一个子节点（O(1)）。"""
        ...

    def prepend(self, node: T) -> None:
        """将 node 插入为 self 的第一个子节点（O(1)）。"""
        ...

    def detach(self) -> None:
        """将 self 从其所在兄弟链表中摘除（O(1)）。"""
        ...

    def has_children(self) -> int:
        """返回 1 若有子节点，否则 0。"""
        return 0

    def child_at(self, index: int) -> Optional[T]:
        """返回第 index 个子节点（O(n)，从 0 开始），越界返回 None。"""
        return None

    def count_children(self) -> int:
        """遍历计算子节点数（O(n)），用于校验 Count。"""
        return 0
