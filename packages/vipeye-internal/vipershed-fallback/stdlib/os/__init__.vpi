# Viper os 包入口存根。
# 根据 platmacro.IS_WINDOWS 分派到 _win32 或 _posix 后端。
# os.path 为跨平台纯字符串操作，直接可用。
# 姑息策略：
#   - _mbuddy 为模块级全局 MemBuddy 指针（int）
#   - 路径参数映射为 str
#   - 文件大小返回 int（int64）
#   - 列举目录的 out_names 为 int（char** 指针）

import t
import memhub
from stdint import *


# 模块级全局 MBuddy 指针（由用户在 main 中赋值初始化）
_mbuddy: int  # memhub.MemBuddy | t.CPtr


# =============================================================================
# 文件/目录属性查询
# =============================================================================
def exists(path: str) -> bool:
    """检查文件/目录是否存在。"""
    return False


def isdir(path: str) -> bool:
    """检查路径是否为目录。"""
    return False


def isfile(path: str) -> bool:
    """检查路径是否为普通文件。"""
    return False


def getsize(path: str) -> int:
    """返回文件大小（字节）。

    Returns:
        文件大小，失败返回 -1
    """
    return 0


# =============================================================================
# 工作目录
# =============================================================================
def getcwd() -> str:
    """返回当前工作目录（通过 _mbuddy 分配内存）。"""
    return ""


def chdir(path: str) -> int:
    """切换当前工作目录。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


# =============================================================================
# 文件/目录操作
# =============================================================================
def mkdir(path: str) -> int:
    """创建目录。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


def remove(path: str) -> int:
    """删除文件。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


def rmdir(path: str) -> int:
    """删除空目录。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


def rename(old_path: str, new_path: str) -> int:
    """重命名/移动文件或目录。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


def chmod(path: str, mode: int) -> int:
    """修改文件权限。

    Windows 上只处理只读位（S_IWUSR）；POSIX 上使用完整权限位。

    Returns:
        成功返回 0，失败返回 -1
    """
    return 0


# =============================================================================
# 目录列举
# =============================================================================
def listdir(path: str, out_names: int, max_count: int) -> int:
    """列举目录下的文件/子目录名。

    Args:
        path: 目录路径
        out_names: 调用者提供的字符串指针数组（char**），每个元素指向一个文件名。
                   文件名通过 _mbuddy 分配内存。
        max_count: out_names 数组最大容量
    Returns:
        实际列举的条目数，失败返回 0
    """
    return 0


# =============================================================================
# 命令执行
# =============================================================================
def system(cmd: str) -> int:
    """执行命令行命令（通过 C 运行时 system()）。

    命令输出直接到终端（继承父进程 stdout/stderr）。

    Args:
        cmd: 命令字符串
    Returns:
        命令的退出码（0 表示成功）
    """
    return 0
