# Viper C stdio.h 函数存根。
# 姑息策略：
#   - 流指针（FILE*）映射为 bytes（姑息用 bytes 表示缓冲区指针）
#   - 字符串格式参数映射为 str
#   - 缓冲区参数映射为 bytes（可变缓冲）
#   - 返回 t.CInt 映射为 int，t.State 映射为 None

from typing import Any


def printf(fmt: str, *args: Any) -> int:
    """格式化输出到 stdout。

    Args:
        fmt: 格式字符串（C 风格 %d/%s/%x/%f 等）
        *args: 格式参数
    Returns:
        写入字符数（t.CInt），失败返回负值
    """
    return 0


def fprintf(stream: bytes, fmt: str, *args: Any) -> int:
    """格式化输出到指定流。

    Args:
        stream: FILE* 指针（姑息用 bytes）
        fmt: 格式字符串
        *args: 格式参数
    Returns:
        写入字符数
    """
    return 0


def sprintf(buf: bytes, fmt: str, *args: Any) -> int:
    """格式化写入到缓冲区（不检查边界，慎用）。

    Args:
        buf: 目标缓冲区（bytes，可变）
        fmt: 格式字符串
        *args: 格式参数
    Returns:
        写入字符数
    """
    return 0


def snprintf(buf: bytes, size: int, fmt: str, *args: Any) -> int:
    """格式化写入到缓冲区（带大小限制）。

    Args:
        buf: 目标缓冲区
        size: 缓冲区最大容量
        fmt: 格式字符串
        *args: 格式参数
    Returns:
        本应写入的字符数（可能 >= size）
    """
    return 0


def puts(s: str) -> int:
    """输出字符串到 stdout 并追加换行。

    Args:
        s: 要输出的字符串
    Returns:
        成功返回非负值，失败返回 EOF
    """
    return 0


def fputs(s: str, stream: bytes) -> int:
    """输出字符串到指定流（不追加换行）。

    Args:
        s: 要输出的字符串
        stream: FILE* 指针
    Returns:
        成功返回非负值，失败返回 EOF
    """
    return 0


def fgets(buf: bytes, size: int, stream: bytes) -> bytes:
    """从流读取一行。

    Args:
        buf: 目标缓冲区
        size: 缓冲区最大容量
        stream: FILE* 指针
    Returns:
        成功返回 buf 指针，失败或 EOF 返回 None
    """
    ...


def fflush(stream: bytes) -> int:
    """刷新流缓冲区。

    Args:
        stream: FILE* 指针，传 0（NULL）刷新所有输出流
    Returns:
        成功返回 0，失败返回 EOF
    """
    return 0


# 标准流指针（全局变量，仅声明供 printf 等函数使用）
stdin: bytes = 0    # 标准输入流
stdout: bytes = 0   # 标准输出流
stderr: bytes = 0   # 标准错误流
