    """
    ...


def strrchr(s: str, cr: int) -> str:
    """在 s 中查找字符 cr 最后一次出现的位置。

    Returns:
        指向该字符的指针，未找到返回 None
    """
    ...


def strstr(s: str, needle: str) -> str:
    """在 s 中查找子串 needle 第一次出现的位置。

    Returns:
        指向子串起始的指针，未找到返回 None
    """
    ...


