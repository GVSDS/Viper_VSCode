def strncpy(dest: str, src: str, n: int) -> str:
    """复制 src 前 n 个字符到 dest。

    不足 n 时用 \\0 填充，超过 n 不追加终止符。

    Args:
        n: 最大复制字节数
    Returns:
        dest 指针
    """
    ...


