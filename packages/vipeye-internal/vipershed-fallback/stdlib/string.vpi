# =============================================================================
# 内存操作
# =============================================================================
def memset(ptr: int, value: int, num: int) -> int:
    """将 ptr 指向的 num 字节内存全部设置为 value。

    Args:
        ptr: 内存指针（int）
        value: 填充值（取低 8 位）
        num: 字节数
    Returns:
        ptr 指针
    """
    return 0


def memset32(ptr: int, value: int, count: int) -> int:
    """将 ptr 指向的 count 个 32 位整数全部设置为 value。

    Args:
        ptr: 内存指针（int）
        value: 32 位填充值
        count: 32 位整数个数
    Returns:
        ptr 指针
    """
    return 0


def memcpy(dest: int, src: int, num: int) -> int:
    """从 src 复制 num 字节到 dest（不处理重叠）。

    Returns:
        dest 指针
    """
    return 0


def memmove(dest: int, src: int, num: int) -> int:
    """从 src 复制 num 字节到 dest（处理重叠）。

    Returns:
        dest 指针
    """
    return 0


def memcmp(ptr1: int, ptr2: int, n: int) -> int:
    """比较两块内存前 n 字节。

    Returns:
        < 0 表示 ptr1 < ptr2，= 0 表示相等，> 0 表示 ptr1 > ptr2
    """
    return 0


