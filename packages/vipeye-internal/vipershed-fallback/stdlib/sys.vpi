# Viper sys 模块存根。
# 提供 C 标准库 IO 声明、平台信息、进程信息、命令行参数访问。
# 姑息策略：
#   - _mbuddy 为模块级全局 MemBuddy 指针（int）
#   - 命令行 argv 数组指针为 int（char**）
#   - exit 终止进程返回 None

import t
import memhub
from stdint import *


# 模块级全局 MBuddy 指针（由用户在 main 中赋值初始化）
_mbuddy: int  # memhub.MemBuddy | t.CPtr


# =============================================================================
# C 标准库 IO 声明（从 sys 模块转发）
# =============================================================================
def fgets(buf: int, size: int, stream: int) -> int:
    """从流读取一行（C stdio 声明）。

    Args:
        buf: 目标缓冲区指针（int）
        size: 缓冲区最大容量
        stream: FILE* 指针（int）
    Returns:
        成功返回 buf 指针，失败返回 0（NULL）
    """
    return 0


def fflush(stream: int) -> int:
    """刷新流缓冲区（C stdio 声明）。

    Args:
        stream: FILE* 指针（int），传 0 刷新所有输出流
    Returns:
        成功返回 0，失败返回 EOF
    """
    return 0


def exit(status: int) -> None:
    """终止进程（刷新缓冲区后终止，跨平台）。

    Args:
        status: 退出码（0 表示成功）
    """
    ...


# =============================================================================
# 平台信息
# =============================================================================
# 最大整数值（64 位平台 ssize_t 上限）
maxsize: int = 9223372036854775807


def platform() -> str:
    """返回平台标识字符串。

    Returns:
        'win32' 或 'linux'
    """
    return ""


# =============================================================================
# 进程信息
# =============================================================================
def get_pid() -> int:
    """返回当前进程 ID。"""
    return 0


# =============================================================================
# 命令行参数（argv）
# =============================================================================
# 全局 argv 状态（首次访问时初始化）
_argc: int = 0
# _argv 是指针数组（char**），姑息映射为 int
_argv: int


def argc() -> int:
    """返回命令行参数个数。首次调用时自动初始化。"""
    return 0


def argv(index: int) -> str:
    """返回第 index 个命令行参数（index 从 0 开始）。

    首次调用时自动初始化。索引越界返回 None。

    Args:
        index: 参数索引（0 = 程序名）
    Returns:
        参数字符串，越界返回 None
    """
    return ""
