# Viper 类型系统模块 t 的存根。
#
# 姑息策略（完善版）：
#   - 基本数值/字符类型使用 TypeAlias 别名（等价 Python 内置类型），
#     使 `k: t.CInt = 1` 合法（1 是 int，CInt 别名 int）
#   - 指针/修饰符/命名类型作为独立 class 继承 CType，
#     保持"类型"语义（绿色高亮）和联合类型 `T | t.CPtr` 支持
#   - CPtr 支持泛型下标 `t.CPtr[t.CInt]`
#   - CArray 支持下标 `t.CArray[t.CInt, 64]`
#
# 来源：D:\Users\TermiNexus\Desktop\TransPyC\lib\includes\t.py
# 仅保留核心语义，省略 CTypeRegistry/attr/ASM_DESCR 等运行时设施。

from typing import Any, Generic, Optional, Type, TypeAlias, TypeVar
from typing import Callable as CallableT

T = TypeVar('T')


# =============================================================================
# CType 基类
# =============================================================================
class CType:
    """C 类型基类。"""
    PREFIX: str
    BASE: str
    POINTER: str
    ARRAY: str
    NAMED: str
    STORAGE_CLASS: str
    TYPE_QUALIFIER: str

    Name: str
    IsBasicType: bool
    IsPointer: bool
    IsSigned: Optional[bool]
    Size: Optional[int]

    def __init__(self, value: Any = None, *types: Any) -> None: ...
    def GetPositions(self) -> frozenset[str]: ...
    def GetFullType(self, VarName: str = '', ArraySizeStr: str = '') -> str: ...
    def __or__(self, other: Any) -> list[Any]: ...
    def __set_default__(self, **kwargs: Any) -> 'CTypeDefault': ...

    # Viper 扩展：__sizeof__ 作为类方法，返回类型的大小（字节数）。
    # C 语义：sizeof(struct memory_block) -> memory_block.__sizeof__()
    # 第一个参数是 cls（类本身），无需显式传递 self。
    @classmethod
    def __sizeof__(cls) -> int: ...


class CTypeDefault(CType):
    """C 类型默认值/初始化包装类。"""
    BaseType: Any
    defaults: dict[str, Any]
    def __init__(self, BaseType: Any, **kwargs: Any) -> None: ...


# =============================================================================
# 基本整数类型（TypeAlias 别名，等价 int）
# =============================================================================
CChar: TypeAlias = int
CShort: TypeAlias = int
CInt: TypeAlias = int
CLong: TypeAlias = int
CLongLong: TypeAlias = int
CSignedChar: TypeAlias = int
CUnsignedChar: TypeAlias = int
CUnsignedShort: TypeAlias = int
CUnsignedInt: TypeAlias = int
CUnsignedLong: TypeAlias = int
CUnsignedLongLong: TypeAlias = int

# 固定宽度整数
CInt8T: TypeAlias = int
CInt16T: TypeAlias = int
CInt32T: TypeAlias = int
CInt64T: TypeAlias = int
CUInt8T: TypeAlias = int
CUInt16T: TypeAlias = int
CUInt32T: TypeAlias = int
CUInt64T: TypeAlias = int

# 最小/最快宽度整数
CIntLeast8T: TypeAlias = int
CIntLeast16T: TypeAlias = int
CIntLeast32T: TypeAlias = int
CIntLeast64T: TypeAlias = int
CIntFast8T: TypeAlias = int
CIntFast16T: TypeAlias = int
CIntFast32T: TypeAlias = int
CIntFast64T: TypeAlias = int
CUIntLeast8T: TypeAlias = int
CUIntLeast16T: TypeAlias = int
CUIntLeast32T: TypeAlias = int
CUIntLeast64T: TypeAlias = int
CUIntFast8T: TypeAlias = int
CUIntFast16T: TypeAlias = int
CUIntFast32T: TypeAlias = int
CUIntFast64T: TypeAlias = int

# 最大宽度整数
CIntMaxT: TypeAlias = int
CUIntMaxT: TypeAlias = int

# 平台相关整数
CSizeT: TypeAlias = int
CIntPtrT: TypeAlias = int
CUIntPtrT: TypeAlias = int
CPtrDiffT: TypeAlias = int

# 布尔
CBool: TypeAlias = int

# 宽字符
CWCharT: TypeAlias = int
CChar8T: TypeAlias = int
CChar16T: TypeAlias = int
CChar32T: TypeAlias = int

# LLVM 简写（直接作为类型别名，等价于固定宽度整数）
i1: TypeAlias = int
i8: TypeAlias = int
i16: TypeAlias = int
i32: TypeAlias = int
i64: TypeAlias = int
u1: TypeAlias = int
u8: TypeAlias = int
u16: TypeAlias = int
u32: TypeAlias = int
u64: TypeAlias = int


# =============================================================================
# 浮点类型（TypeAlias 别名，等价 float）
# =============================================================================
CFloat: TypeAlias = float
CDouble: TypeAlias = float
CFloat8T: TypeAlias = float
CFloat16T: TypeAlias = float
CFloat32T: TypeAlias = float
CFloat64T: TypeAlias = float
CFloat128T: TypeAlias = float


# =============================================================================
# void 类型
# =============================================================================
class CVoid(CType):
    """void 类型。Size=0，IsSigned=None。"""
    pass


# =============================================================================
# 指针类型（支持泛型下标）
# =============================================================================
class CPtr(CType, Generic[T]):
    """指针类型。用法: t.CPtr[t.CInt] 表示 int*。"""
    def __class_getitem__(cls, item: Any) -> type: ...
    # 指针解引用：通过 __getattr__/__setattr__ 将属性访问转发到 T 的字段。
    # 模拟 C 语言的 ptr->field 语义。
    def __getattr__(self, name: str) -> T: ...
    def __setattr__(self, name: str, value: T) -> None: ...


class CNeedPtr(CPtr):
    """函数签名注解：自动取地址（仅对非指针值）。"""
    pass


class CAutoPtr(CPtr):
    """函数签名注解：无条件取地址。"""
    pass


class CArrayPtr(CType):
    """数组指针。"""
    pass


# =============================================================================
# 数组类型（支持下标）
# =============================================================================
class CArray(CType):
    """栈上固定数组类型注解。
    用法: names: t.CArray[VOIDPTR, 32]  # void*[32]
          data: t.CArray[t.CInt, 64]    # int[64]
    """
    def __class_getitem__(cls, item: Any) -> type: ...
    def __getitem__(self, index: int) -> Any: ...
    def __setitem__(self, index: int, value: Any) -> None: ...


# =============================================================================
# 修饰符类型（用于联合类型注解）
# =============================================================================
class CConst(CType):
    """const 类型限定符。"""
    pass


class CVolatile(CType):
    """volatile 类型限定符。"""
    pass


class CStatic(CType):
    """static 存储类。"""
    pass


class CExtern(CType):
    """extern 存储类。"""
    pass


class CInline(CType):
    """inline 存储类。"""
    pass


class CExport(CType):
    """导出符号存储类。"""
    pass


class CRegister(CType):
    """register 存储类。"""
    pass


class CAuto(CType):
    """auto 存储类。"""
    pass


class CPass(CType):
    """占位类型。"""
    pass


class CUnsigned(CType):
    """unsigned 修饰符。"""
    pass


class State(CType):
    """状态标记，等价 CExport | CExtern。仅声明不定义。"""
    pass


# CDefine 是编译时元指令（非数据类型）：
#  - 单独使用（t.CDefine）：类型检查时视为任意类型，可接受任何值，可传给任何参数
#  - 联合使用（t.CDefine | t.CInt）：CDefine 被过滤，按 t.CInt 规则严格检查
#  - 右值位或运算（MAX_SIZE | PAGE_SIZE）：结果仍为 CDefine，保持任意传参语义
#  - 代码生成时 t.CDefine 常量/函数会被完全内联展开，不生成 LLVM IR 声明
# 注：严格联合语义由 typeEvaluator.combineTypes 中的特殊处理实现
class CDefine(CType):
    """编译期宏定义类型（编译时元指令）。"""
    def __or__(self, other: Any) -> 'CDefine':
        """位或运算结果保持 CDefine 类型（任意传参语义）。"""
        ...
    def __ror__(self, other: Any) -> 'CDefine':
        """反向位或运算结果保持 CDefine 类型。"""
        ...


# CTypedef 是 TypeAlias 的别名（用于 typedef 语义）
CTypedef: TypeAlias = TypeAlias


# =============================================================================
# OOP 修饰符（函数形式，用作装饰器）
# Object/NoVTable 为类装饰器：接收 type 返回 type
# CVTable 为类装饰器：接收 type 返回 type
# TLS 为函数装饰器：接收 Callable 返回 Callable
# 使用 Type[T] -> Type[T] 保留被装饰类的类型信息
# =============================================================================
def Object(cls: Type[T]) -> Type[T]:
    """Python 对象类型装饰器（类方法外联函数）。"""
    ...


def CVTable(cls: Type[T]) -> Type[T]:
    """启用多态 vtable 装饰器。"""
    ...


def NoVTable(cls: Type[T]) -> Type[T]:
    """标记类为非多态继承基类：子类继承时字段直接展平嵌入，不生成 vtable。"""
    ...


def TLS(func: CallableT[..., Any]) -> CallableT[..., Any]:
    """标记函数为 TLS 初始化函数。"""
    ...


