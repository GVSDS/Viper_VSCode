# =============================================================================
# C 语言 __attribute__ 属性操作类型
# =============================================================================
class attr:
    """C 语言 __attribute__ 属性操作类型。

    来源：D:\\Users\\TermiNexus\\Desktop\\TransPyC\\lib\\includes\\t.py
    """
    @staticmethod
    def noreturn() -> str: ...
    @staticmethod
    def format(printf: Any, arg1: Any, arg2: Any) -> str: ...
    @staticmethod
    def section(name: str) -> str: ...
    @staticmethod
    def aligned(bytes: int) -> str: ...
    @staticmethod
    def packed() -> str: ...
    @staticmethod
    def unused() -> str: ...
    @staticmethod
    def used() -> str: ...
    @staticmethod
    def weak() -> str: ...
    @staticmethod
    def alias(name: str) -> str: ...
    @staticmethod
    def visibility(type: str) -> str: ...
    @staticmethod
    def constructor() -> str: ...
    @staticmethod
    def destructor() -> str: ...
    @staticmethod
    def always_inline() -> str: ...
    @staticmethod
    def noinline() -> str: ...
    @staticmethod
    def pure() -> str: ...
    @staticmethod
    def const() -> str: ...
    @staticmethod
    def malloc() -> str: ...
    @staticmethod
    def alloc_size(n: int) -> str: ...
    @staticmethod
    def warn_unused_result() -> str: ...
    @staticmethod
    def deprecated(msg: Optional[str] = None) -> str: ...
    @staticmethod
    def fallthrough() -> str: ...
    @staticmethod
    def likely() -> str: ...
    @staticmethod
    def unlikely() -> str: ...
    @staticmethod
    def hot() -> str: ...
    @staticmethod
    def cold() -> str: ...
    @staticmethod
    def interrupt() -> str: ...
    @staticmethod
    def naked() -> str: ...
    @staticmethod
    def sentinel(n: int = 0) -> str: ...
    @staticmethod
    def nonnull(*args: Any) -> str: ...
    @staticmethod
    def returns_nonnull() -> str: ...
    @staticmethod
    def access(mode: Any, *args: Any) -> str: ...
    @staticmethod
    def cleanup(func: str) -> str: ...
    @staticmethod
    def transparent_union() -> str: ...
    @staticmethod
    def mode(mode_name: str) -> str: ...
    @staticmethod
    def vector_size(bytes: int) -> str: ...
    @staticmethod
    def target(string: str) -> str: ...
    @staticmethod
    def optimize(level: str) -> str: ...
    @staticmethod
    def no_instrument_function() -> str: ...
    @staticmethod
    def no_sanitize(type: str) -> str: ...
    @staticmethod
    def no_stack_protector() -> str: ...
    @staticmethod
    def stack_protector() -> str: ...
    @staticmethod
    def error(msg: str) -> str: ...
    @staticmethod
    def warning(msg: str) -> str: ...

    class llvm:
        """LLVM 函数属性描述符。

        用于在返回类型注解中指定 LLVM 函数属性。
        例如: def foo() -> t.CInt | t.attr.llvm.nobuiltin | t.attr.llvm.nounwind:
        """

        class nobuiltin: pass
        class nounwind: pass
        class noredzone: pass
        class willreturn: pass
        class mustprogress: pass
        class optnone: pass
        class noinline: pass
        class alwaysinline: pass
        class readnone: pass
        class readonly: pass
        class writeonly: pass
        class inaccessiblememonly: pass
        class inaccessiblemem_or_argmemonly: pass


