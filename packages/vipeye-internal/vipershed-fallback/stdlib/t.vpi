    """内嵌 ASM 破坏描述符类。

    定义所有可能的破坏描述符和约束字符，用于 GCC 内嵌汇编。
    来源：D:\\Users\\TermiNexus\\Desktop\\TransPyC\\lib\\includes\\t.py
    """
    # 操作数修饰符
    MODIFIER_OUTPUT: str
    MODIFIER_READWRITE: str
    MODIFIER_INPUT: str
    MODIFIER_GLOBAL: str

    # 寄存器约束（32位命名）
    REG_ANY: str
    REG_EAX: str
    REG_EBX: str
    REG_ECX: str
    REG_EDX: str
    REG_ESI: str
    REG_EDI: str
    REG_STACK: str
    REG_FLOAT: str
    REG_MMX: str
    REG_XMM: str

