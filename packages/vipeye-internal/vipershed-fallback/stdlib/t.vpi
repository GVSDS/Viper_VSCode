class CStruct(CType):
    """struct 命名类型。"""
    pass


class CUnion(CType):
    """union 命名类型。"""
    pass


class CEnum(CType):
    """enum 命名类型。"""
    pass


# Enum 是 CEnum 的别名
Enum: TypeAlias = CEnum


class REnum(CType):
    """运行时 enum 命名类型。"""
    pass


class Anonymous(CType):
    """匿名类型标记。"""
    pass


# =============================================================================
# 位域与字节序
# =============================================================================
class Bit:
    """位域标记。"""
    def __init__(self, i: Any) -> None: ...


class BigEndian(CType):
    """大端序字节序标记类。"""
    IsSigned: bool
    Size: int
    Align: int


class LittleEndian(CType):
    """小端序字节序标记类。"""
    IsSigned: bool
    Size: int
    Align: int


# =============================================================================
# C 语言 __attribute__ 属性操作类型
# =============================================================================
class attr:
    """C 语言 __attribute__ 属性操作类型。

    来源：D:\\Users\\TermiNexus\\Desktop\\TransPyC\\lib\\includes\\t.py
    """
    @staticmethod
    def noreturn() -> str: ...
    @staticmethod
    def format(printf: Any, arg1: Any, arg2: Any) -> str: ...
    @staticmethod
    def section(name: str) -> str: ...
    @staticmethod
    def aligned(bytes: int) -> str: ...
    @staticmethod
    def packed() -> str: ...
    @staticmethod
    def unused() -> str: ...
    @staticmethod
    def used() -> str: ...
    @staticmethod
    def weak() -> str: ...
    @staticmethod
    def alias(name: str) -> str: ...
    @staticmethod
    def visibility(type: str) -> str: ...
    @staticmethod
    def constructor() -> str: ...
    @staticmethod
    def destructor() -> str: ...
    @staticmethod
    def always_inline() -> str: ...
    @staticmethod
    def noinline() -> str: ...
    @staticmethod
    def pure() -> str: ...
    @staticmethod
    def const() -> str: ...
    @staticmethod
    def malloc() -> str: ...
    @staticmethod
    def alloc_size(n: int) -> str: ...
    @staticmethod
    def warn_unused_result() -> str: ...
    @staticmethod
    def deprecated(msg: Optional[str] = None) -> str: ...
    @staticmethod
    def fallthrough() -> str: ...
    @staticmethod
    def likely() -> str: ...
    @staticmethod
    def unlikely() -> str: ...
    @staticmethod
    def hot() -> str: ...
    @staticmethod
    def cold() -> str: ...
    @staticmethod
    def interrupt() -> str: ...
    @staticmethod
    def naked() -> str: ...
    @staticmethod
    def sentinel(n: int = 0) -> str: ...
    @staticmethod
    def nonnull(*args: Any) -> str: ...
    @staticmethod
    def returns_nonnull() -> str: ...
    @staticmethod
    def access(mode: Any, *args: Any) -> str: ...
    @staticmethod
    def cleanup(func: str) -> str: ...
    @staticmethod
    def transparent_union() -> str: ...
    @staticmethod
    def mode(mode_name: str) -> str: ...
    @staticmethod
    def vector_size(bytes: int) -> str: ...
    @staticmethod
    def target(string: str) -> str: ...
    @staticmethod
    def optimize(level: str) -> str: ...
    @staticmethod
    def no_instrument_function() -> str: ...
    @staticmethod
    def no_sanitize(type: str) -> str: ...
    @staticmethod
    def no_stack_protector() -> str: ...
    @staticmethod
    def stack_protector() -> str: ...
    @staticmethod
    def error(msg: str) -> str: ...
    @staticmethod
    def warning(msg: str) -> str: ...

    class llvm:
        """LLVM 函数属性描述符。

        用于在返回类型注解中指定 LLVM 函数属性。
        例如: def foo() -> t.CInt | t.attr.llvm.nobuiltin | t.attr.llvm.nounwind:
        """

        class nobuiltin: pass
        class nounwind: pass
        class noredzone: pass
        class willreturn: pass
        class mustprogress: pass
        class optnone: pass
        class noinline: pass
        class alwaysinline: pass
        class readnone: pass
        class readonly: pass
        class writeonly: pass
        class inaccessiblememonly: pass
        class inaccessiblemem_or_argmemonly: pass


# ASM 描述符
# =============================================================================
class ASM_DESCR:
    """内嵌 ASM 破坏描述符类。

    定义所有可能的破坏描述符和约束字符，用于 GCC 内嵌汇编。
    来源：D:\\Users\\TermiNexus\\Desktop\\TransPyC\\lib\\includes\\t.py
    """
    # 操作数修饰符
    MODIFIER_OUTPUT: str
    MODIFIER_READWRITE: str
    MODIFIER_INPUT: str
    MODIFIER_GLOBAL: str

    # 寄存器约束（32位命名）
    REG_ANY: str
    REG_EAX: str
    REG_EBX: str
    REG_ECX: str
    REG_EDX: str
    REG_ESI: str
    REG_EDI: str
    REG_STACK: str
    REG_FLOAT: str
    REG_MMX: str
    REG_XMM: str

    # 寄存器约束（64位命名，GCC约束字符与32位相同）
    REG_RAX: str
    REG_RBX: str
    REG_RCX: str
    REG_RDX: str
    REG_RSI: str
    REG_RDI: str
    REG_R8: str
    REG_R9: str
    REG_R10: str
    REG_R11: str
    REG_R12: str
    REG_R13: str
    REG_R14: str
    REG_R15: str
    REG_RBP: str
    REG_RSP: str

    # 内存约束
    MEMORY: str

    # 立即数约束
    IMMEDIATE: str
    IMMEDIATE_CONST: str

    # 综合约束
    ANY: str
    MEMORY_OR_REG: str

    # 破坏描述符 - 32位寄存器
    CLOBBER_EAX: str
    CLOBBER_EBX: str
    CLOBBER_ECX: str
    CLOBBER_EDX: str
    CLOBBER_ESI: str
    CLOBBER_EDI: str
    CLOBBER_EBP: str
    CLOBBER_ESP: str

    # 破坏描述符 - 8位寄存器
    CLOBBER_AL: str
    CLOBBER_AH: str
    CLOBBER_BL: str
    CLOBBER_BH: str
    CLOBBER_CL: str
    CLOBBER_CH: str
    CLOBBER_DL: str
    CLOBBER_DH: str

    # 破坏描述符 - 特殊
    CLOBBER_CC: str
    CLOBBER_MEMORY: str

    # 破坏描述符 - 16位寄存器
    CLOBBER_AX: str
    CLOBBER_BX: str
    CLOBBER_CX: str
    CLOBBER_DX: str
    CLOBBER_SI: str
    CLOBBER_DI: str
    CLOBBER_BP: str

    # 破坏描述符 - 64位寄存器
    CLOBBER_RAX: str
    CLOBBER_RBX: str
    CLOBBER_RCX: str
    CLOBBER_RDX: str
    CLOBBER_RSI: str
    CLOBBER_RDI: str
    CLOBBER_RBP: str
    CLOBBER_RSP: str
    CLOBBER_R8: str
    CLOBBER_R9: str
    CLOBBER_R10: str
    CLOBBER_R11: str
    CLOBBER_R12: str
    CLOBBER_R13: str
    CLOBBER_R14: str
    CLOBBER_R15: str

    # 预定义组合约束 - 输出（32位命名）
    OUTPUT_REG: str
    OUTPUT_MEM: str
    OUTPUT_EAX: str
    OUTPUT_EBX: str
    OUTPUT_ECX: str
    OUTPUT_EDX: str
    OUTPUT_ESI: str
    OUTPUT_EDI: str

