def vsprintf(buf: int, rule: str, *args: Any) -> int:
    """可变参数版本的 sprintf。

    Args:
        buf: 目标缓冲区指针（int）
        rule: 格式字符串
        *args: 格式参数
    Returns:
        写入字符数
    """
    return 0


def snprintf(buf: int, size: int, fmt: str, *args: Any) -> int:
    """格式化写入到缓冲区（带大小限制）。

    Args:
        buf: 目标缓冲区指针（int）
        size: 缓冲区最大容量
        fmt: 格式字符串
        *args: 格式参数
    Returns:
        本应写入的字符数
    """
    return 0


def vsnprintf(buf: int, size: int, fmt: str, ap: int) -> int:
    """可变参数版本的 snprintf。

    支持的格式说明符：%c %s %d %i %u %x %X %o %b %p %f %F %e %E %g %G %a %A %n %%
    支持的修饰符：- 0 + 空格 # 宽度 .精度 h hh l ll z j t

    Args:
        buf: 目标缓冲区指针（int）
        size: 缓冲区最大容量
        fmt: 格式字符串
        ap: va_list 参数列表指针（int）
    Returns:
        写入字符数
    """
    return 0


