# Viper 标准库扩展 viperlib 存根。
# 提供 snprintf/sprintf/vsnprintf 等 C 风格格式化函数的纯 Viper 实现。
# 姑息策略：
#   - 缓冲区指针映射为 int（指针整数）
#   - 格式字符串映射为 str
#   - va_list 参数列表映射为 int（指针整数）
#   - 返回 t.CInt 映射为 int

from typing import Any


