{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "./out",
        "rootDir": "../..",
        "paths": {
            "vipeye-internal/*": ["../vipeye-internal/src/*"]
        },
        "typeRoots": ["./node_modules/@types", "../vipeye-internal/typings"]
    },
    "include": ["src/**/*", "**/*.js", "../vipeye-internal/typings/*.d.ts"],
    "exclude": ["node_modules", "dist", "out", "vipeye-typeserver.js"]
}
