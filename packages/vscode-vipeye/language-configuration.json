{
    "comments": {
        "lineComment": "#",
        "blockComment": ["\"\"\"", "\"\"\""]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "\"\"\"", "close": "\"\"\"", "notIn": ["string"] },
        { "open": "'''", "close": "'''", "notIn": ["string", "comment"] }
    ],
    "surroundingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"" },
        { "open": "'", "close": "'" },
        { "open": "\"\"\"", "close": "\"\"\"" },
        { "open": "'''", "close": "'''" }
    ],
    "onEnterRules": [
        {
            "beforeText": "^\\s*(?:(?:inline|export|extern)\\s+(?:def|fn|fun|func|function)|(?:export|extern)\\s+[A-Za-z_][A-Za-z0-9_]*|(?:enum|rnum|union)\\s+(?:class|struct)|(?:enum|rnum|union)\\s+[A-Za-z_][A-Za-z0-9_]*|(?:def|fn|fun|func|function|class|for|if|elif|else|while|try|finally|with|except|async|struct))\\b.*?:\\s*$",
            "action": { "indent": "indent" }
        },
        {
            "beforeText": "^\\s*(?:\"\"\"|''')",
            "action": { "indent": "indent" }
        }
    ],
    "folding": {
        "offSide": true,
        "markers": {
            "start": "^\\s*#\\s*region\\b",
            "end": "^\\s*#\\s*endregion\\b"
        }
    },
    "wordPattern": "(?x)\n  \\b\\w*\\b  \n  |  (?<=\\.)\\w+\n  | (?<=@)\\w+\n  | \\p{Lu}[\\p{Ll}_\\p{Lu}\\p{Nd}]*\n  | [[:alpha:]_][[:alpha:]_\\p{Nd}]*\n  | \\p{Lu}[\\p{Ll}_\\p{Lu}\\p{Nd}]*f?\\b",
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(?:(?:inline|export|extern)\\s+(?:def|fn|fun|func|function)|(?:export|extern)\\s+[A-Za-z_][A-Za-z0-9_]*|(?:enum|rnum|union)\\s+(?:class|struct)|(?:enum|rnum|union)\\s+[A-Za-z_][A-Za-z0-9_]*|(?:class|def|fn|fun|func|function|elif|else|except|finally|for|if|try|while|with|struct|async\\s+def|async\\s+for|async\\s+with))\\b.*?:\\s*$",
        "decreaseIndentPattern": "^\\s*(elif|else|except|finally)\\b.*?:\\s*$"
    }
}
