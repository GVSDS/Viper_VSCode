{
    "name": "Viper",
    "scopeName": "source.viper",
    "patterns": [
        {
            "include": "#comment"
        },
        {
            "include": "#keyword"
        },
        {
            "include": "#string"
        },
        {
            "include": "#number"
        },
        {
            "include": "#decorator"
        }
    ],
    "repository": {
        "comment": {
            "patterns": [
                {
                    "name": "comment.line.number-sign.viper",
                    "match": "#.*$"
                }
            ]
        },
        "keyword": {
            "patterns": [
                {
                    "name": "keyword.control.flow.viper",
                    "match": "\\b(if|elif|else|while|for|in|return|break|continue|pass|raise|try|except|finally|with|as|import|from|yield|async|await|del|assert|lambda|match|case|define)\\b"
                },
                {
                    "name": "storage.type.function.viper",
                    "match": "\\bdef\\b"
                },
                {
                    "name": "storage.type.function.viper",
                    "match": "\\b(fn|fun|func|function)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*|\\s*$)"
                },
                {
                    "name": "storage.type.class.viper",
                    "match": "\\bclass\\b"
                },
                {
                    "name": "storage.modifier.viper",
                    "match": "\\b(inline|export|extern)\\b(?=\\s+(?:def|fn|fun|func|function|while|for)\\b|\\s+[A-Za-z_][A-Za-z0-9_]*|[ \\t]*$)"
                },
                {
                    "name": "storage.modifier.viper",
                    "match": "\\b(virtual|novirtual)\\b(?=\\s+(?:class|def|fn|fun|func|function)\\b)"
                },
                {
                    "name": "storage.modifier.viper",
                    "match": "\\b(const|volatile)\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*|\\s*\\[)"
                },
                {
                    "name": "storage.modifier.viper",
                    "match": "\\b__attribute__(?=\\s*\\()"
                },
                {
                    "name": "storage.type.class.viper",
                    "match": "\\b(enum|rnum|union)\\b(?=\\s+(class|struct)\\b|\\s+[A-Za-z_][A-Za-z0-9_]*)"
                },
                {
                    "name": "storage.type.class.viper",
                    "match": "\\bstruct\\b"
                },
                {
                    "name": "storage.type.viper",
                    "match": "\\btypedef\\b(?=\\s+[A-Za-z_][A-Za-z0-9_]*\\s*=)"
                },
                {
                    "name": "keyword.other.viper",
                    "match": "\\b(global|nonlocal|is|not|and|or|type)\\b"
                },
                {
                    "name": "constant.language.null.viper",
                    "match": "\\bNone\\b"
                },
                {
                    "name": "constant.language.boolean.viper",
                    "match": "\\b(True|False)\\b"
                }
            ]
        },
        "string": {
            "patterns": [
                {
                    "name": "string.quoted.double.block.viper",
                    "begin": "\"\"\"",
                    "end": "\"\"\"",
                    "patterns": [
                        {
                            "include": "#string-escape"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.block.viper",
                    "begin": "'''",
                    "end": "'''",
                    "patterns": [
                        {
                            "include": "#string-escape"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.quoted.double.viper",
                    "begin": "\"",
                    "end": "\"|$",
                    "patterns": [
                        {
                            "include": "#string-escape"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                },
                {
                    "name": "string.quoted.single.viper",
                    "begin": "'",
                    "end": "'|$",
                    "patterns": [
                        {
                            "include": "#string-escape"
                        },
                        {
                            "include": "#fstring-interpolation"
                        }
                    ]
                }
            ]
        },
        "string-escape": {
            "patterns": [
                {
                    "name": "constant.character.escape.viper",
                    "match": "\\\\."
                }
            ]
        },
        "fstring-interpolation": {
            "patterns": [
                {
                    "name": "meta.embedded.interpolation.viper",
                    "match": "\\{[^}]*\\}"
                }
            ]
        },
        "number": {
            "patterns": [
                {
                    "name": "constant.numeric.viper",
                    "match": "\\b(0x[0-9a-fA-F]+|0o[0-7]+|0b[01]+|\\d+\\.?\\d*([eE][+-]?\\d+)?)\\b"
                }
            ]
        },
        "decorator": {
            "patterns": [
                {
                    "name": "entity.name.function.decorator.viper",
                    "match": "@[a-zA-Z_][a-zA-Z0-9_.]*"
                }
            ]
        }
    }
}
